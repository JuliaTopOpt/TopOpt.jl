# Quarto render output
/_site/
/site_libs/

# Rendered HTML (built from .qmd)
*.html

# Quarto cache and freeze (execution results)
/.quarto/
/_freeze/

# Jupyter notebooks generated by Quarto
**/*.quarto_ipynb
**/*_ipynb

# Julia cache and precompilation
# The Manifest is committed (see the repository .gitignore) so the CI
# tutorial jobs resolve the exact environment the tutorials were verified
# against.
/*.ji
/sysimage.*

# Julia artifacts and local environment
/LocalPreferences.toml

# OS files
.DS_Store
Thumbs.db
